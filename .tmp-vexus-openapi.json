os na requisição"},"403":{"description":"Endereço IP não autorizado"},"404":{"description":"Carteira ou usuário não encontrado"},"500":{"description":"Erro no servidor"}}}},"/api/crypto/fees":{"get":{"summary":"Consultar taxas de crypto","description":"Retorna taxas e limites para saque crypto para o usuário autenticado.","tags":["Crypto"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Taxas retornadas com sucesso"},"401":{"description":"Não autorizado"},"500":{"description":"Erro no servidor"}}}},"/api/crypto/status/{transactionId}":{"get":{"summary":"Consultar status do saque crypto","description":"Retorna o status do saque crypto por transactionId para o usuário autenticado.","tags":["Crypto"],"security":[{"bearerAuth":[]}],"parameters":[{"in":"path","name":"transactionId","required":true,"schema":{"type":"string"},"description":"ID da transação gerado no saque crypto"}],"responses":{"200":{"description":"Status retornado com sucesso"},"401":{"description":"Não autorizado"},"404":{"description":"Saque não encontrado"},"500":{"description":"Erro no servidor"}}}},"/api/subaccounts/users/batch":{"post":{"summary":"Criar subcontas de usuário em lote","description":"Cria contas de usuário vinculadas ao dono do token JWT (subcontas), com processamento parcial por item.","tags":["Subaccounts"],"security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["accounts"],"properties":{"accounts":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"object","properties":{"nome":{"type":"string"},"first_name":{"type":"string"},"sobrenome":{"type":"string"},"last_name":{"type":"string"},"data_nascimento":{"type":"string","format":"date"},"birth_date":{"type":"string","format":"date"},"cpf_ou_cnpj":{"type":"string"},"document":{"type":"string"},"cep":{"type":"string"},"zip_code":{"type":"string"},"cidade":{"type":"string"},"city":{"type":"string"},"rua":{"type":"string"},"street":{"typ